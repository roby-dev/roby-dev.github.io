---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
import { developer } from '../data/portfolio';
---

<Layout title={developer.name + ' — ' + developer.title}>
  <Header />

  <main id="contenido-principal" class="mx-auto w-full max-w-7xl flex-grow px-4 sm:px-7 lg:px-10">
    <Hero />
    <Stats />
    <Services />
    <Projects />
    <Experience />
    <TechStack />
    <Contact />
  </main>

  <footer class="border-t border-white/10 py-8">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-4 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between sm:px-7 lg:px-10">
      <p>© {new Date().getFullYear()} {developer.name}</p>
      <p>Construido con Astro y Tailwind CSS.</p>
    </div>
  </footer>
</Layout>
