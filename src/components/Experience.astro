---
import { experiences } from '../data/portfolio';
---

<section id="experiencia" aria-labelledby="experience-heading" class="full-bleed theme-dark py-20 sm:py-28">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="font-mono text-xs font-black uppercase tracking-[0.18em] text-accent">01 / Trayectoria</p>
      <h2 id="experience-heading" class="mt-4 text-5xl font-black uppercase leading-none tracking-[-0.06em] sm:text-6xl">
        Experiencia<br /><span class="text-accent">que entrega.</span>
      </h2>
      <p class="mt-6 max-w-sm text-base leading-7 text-bg-dark/65">
        Sistemas críticos, integraciones financieras y productos que necesitan funcionar más allá de la demo.
      </p>
    </div>

    <ol class="border-t border-white/25 lg:col-span-8">
      {
        experiences.map((experience, index) => (
          <li class="border-b border-white/25 py-9 sm:py-11">
            <article class="grid gap-6 sm:grid-cols-[4.5rem_1fr]">
              <span class="font-mono text-3xl font-black text-accent" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                  <div>
                    <h3 class="text-2xl font-black tracking-[-0.035em] text-bg-dark">{experience.role}</h3>
                    <p class="mt-2 text-sm font-black uppercase tracking-[0.1em] text-accent">{experience.company}</p>
                  </div>
                  <p class="shrink-0 font-mono text-[0.68rem] leading-5 text-bg-dark/50">{experience.period}</p>
                </div>

                <ul class="mt-7 grid gap-4">
                  {
                    experience.tasks.map((task) => (
                      <li class="grid grid-cols-[0.8rem_1fr] gap-3 text-[0.95rem] leading-7 text-bg-dark/68">
                        <span class="mt-[0.7rem] h-px bg-accent" aria-hidden="true" />
                        <span>{task}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
