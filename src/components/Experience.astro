---
import { experiences } from '../data/portfolio';
---

<section id="experiencia" aria-labelledby="experience-heading" class="border-b border-border-dark py-20 sm:py-24 lg:py-28">
  <div class="mb-12 max-w-2xl sm:mb-16">
    <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">Trayectoria</p>
    <h2 id="experience-heading" class="text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
      Experiencia
    </h2>
    <p class="mt-4 text-base leading-7 text-muted">
      Sistemas críticos, integraciones financieras y plataformas orientadas a resultados operativos.
    </p>
  </div>

  <ol>
    {
      experiences.map((experience) => (
        <li class="border-t border-border-dark py-10 first:pt-8 sm:py-12">
          <article class="grid gap-5 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <p class="font-mono text-xs leading-6 text-subtle">{experience.period}</p>
              <h3 class="mt-3 text-xl font-semibold leading-7 tracking-[-0.02em] text-ink">
                {experience.role}
              </h3>
              <p class="mt-2 text-sm font-semibold text-accent">{experience.company}</p>
            </div>

            <ul class="space-y-4 lg:col-span-8">
              {
                experience.tasks.map((task) => (
                  <li class="flex gap-4 text-[0.95rem] leading-7 text-muted">
                    <span class="mt-[0.7rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span>{task}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</section>
