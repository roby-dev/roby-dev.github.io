---
import { experiences } from '../data/portfolio';
---

<section id="experiencia" aria-labelledby="experience-heading" class="py-16 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-accent-soft">02 / Trayectoria</p>
      <h2 id="experience-heading" class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.045em] text-ink sm:text-5xl">
        Experiencia aplicada a sistemas exigentes.
      </h2>
      <p class="mt-6 max-w-sm text-sm leading-7 text-muted">
        Integraciones financieras, modernización, operación y producto con responsabilidad de extremo a extremo.
      </p>
    </div>

    <ol class="border-t border-white/10 lg:col-span-8">
      {
        experiences.map((experience, index) => (
          <li class="fade-up border-b border-white/10 py-8 sm:py-10">
            <article class="grid min-w-0 gap-5 sm:grid-cols-[2.75rem_minmax(0,1fr)]">
              <span class="font-mono text-xs font-semibold text-accent-soft" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                  <div class="min-w-0">
                    <h3 class="text-xl font-semibold tracking-[-0.025em] text-ink sm:text-2xl">{experience.role}</h3>
                    <p class="mt-2 text-xs font-semibold uppercase tracking-[0.12em] text-accent-soft">{experience.company}</p>
                  </div>
                  <p class="shrink-0 font-mono text-[0.66rem] leading-5 text-subtle">{experience.period}</p>
                </div>

                <ul class="mt-6 grid gap-3">
                  {
                    experience.tasks.map((task) => (
                      <li class="grid min-w-0 grid-cols-[0.5rem_minmax(0,1fr)] gap-3 text-sm leading-7 text-muted">
                        <span class="mt-[0.72rem] size-1 rounded-full bg-accent" aria-hidden="true" />
                        <span>{task}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
