---
import { projects } from '../data/portfolio';
import Icon from './Icon.astro';

const personalProjects = projects.filter((project) => project.type === 'personal');
const professionalProjects = projects.filter((project) => project.type === 'professional');

const projectFlows = [
  ['Excel', 'Gestión', 'Reportes'],
  ['Local', 'Dominio', 'Datos'],
];
---

<section id="proyectos" aria-labelledby="projects-heading" class="py-16 sm:py-24">
  <div class="grid gap-6 border-b border-white/10 pb-9 md:grid-cols-12 md:items-end">
    <div class="md:col-span-8">
      <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-accent-soft">01 / Trabajo seleccionado</p>
      <h2 id="projects-heading" class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.045em] text-ink sm:text-6xl">
        Ingeniería que se entiende<br class="hidden sm:block" /> por sus decisiones.
      </h2>
    </div>
    <p class="max-w-md text-sm leading-7 text-muted md:col-span-4 md:justify-self-end">
      Productos propios y soluciones profesionales presentados sin cifras infladas ni capturas ficticias.
    </p>
  </div>

  <div class="mt-9 grid gap-5 lg:grid-cols-2">
    {
      personalProjects.map((project, index) => (
        <article class="fade-up group min-w-0 overflow-hidden rounded-xl border border-white/10 bg-panel p-4 transition-transform duration-300 hover:-translate-y-1 sm:p-6">
          <div class="project-visual rounded-lg" aria-hidden="true">
            <div class="absolute inset-x-0 top-0 z-10 flex h-10 items-center gap-1.5 border-b border-white/10 bg-panel/95 px-4">
              <span class="size-1.5 rounded-full bg-accent/70"></span>
              <span class="size-1.5 rounded-full bg-white/15"></span>
              <span class="size-1.5 rounded-full bg-white/15"></span>
              <span class="ml-auto font-mono text-[0.55rem] uppercase tracking-[0.13em] text-subtle">System view</span>
            </div>
            <div class="project-flow">
              {projectFlows[index].map((label) => <span class="project-node rounded-md">{label}</span>)}
            </div>
          </div>

          <div class="px-1 pb-1 pt-6 sm:px-2">
            <div class="flex items-center justify-between gap-4">
              <p class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-accent-soft">Producto propio</p>
              <span class="font-mono text-[0.62rem] text-subtle">0{index + 1}</span>
            </div>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em] text-ink sm:text-3xl">{project.title}</h3>
            <p class="mt-4 text-sm leading-7 text-muted">{project.description}</p>

            <ul class="mt-5 flex flex-wrap gap-2" aria-label={'Tecnologías de ' + project.title}>
              {project.tech.map((technology) => <li class="rounded-full border border-white/10 bg-surface/60 px-3 py-1.5 text-xs font-medium text-muted">{technology}</li>)}
            </ul>

            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent-soft transition-colors hover:text-ink" aria-label="Abrir el perfil de GitHub en una pestaña nueva">
                <Icon name="github" size={16} /> Ver en GitHub <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-14 rounded-xl border border-white/10 bg-panel p-5 sm:p-8">
    <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-accent-soft">Entorno financiero</p>
        <h3 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-ink">Sistemas profesionales</h3>
      </div>
      <p class="text-sm text-subtle">Caja Tacna · Casos seleccionados</p>
    </div>

    <div class="divide-y divide-white/10">
      {
        professionalProjects.map((project, index) => (
          <article class="group grid gap-5 py-7 sm:grid-cols-[3rem_minmax(0,1fr)] sm:py-8 lg:grid-cols-[3rem_minmax(0,1.25fr)_minmax(14rem,0.75fr)] lg:items-start">
            <span class="font-mono text-xs font-semibold text-accent-soft">{String(index + 3).padStart(2, '0')}</span>
            <div class="min-w-0">
              <h4 class="text-xl font-semibold tracking-[-0.02em] text-ink transition-colors group-hover:text-accent-soft sm:text-2xl">{project.title}</h4>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">{project.description}</p>
            </div>
            <ul class="flex flex-wrap gap-x-4 gap-y-2 sm:col-start-2 lg:col-start-auto lg:justify-end" aria-label={'Tecnologías de ' + project.title}>
              {project.tech.map((technology) => <li class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.08em] text-subtle">{technology}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
