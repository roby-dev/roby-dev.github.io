---
import { projects } from '../data/portfolio';
import Icon from './Icon.astro';

const personalProjects = projects.filter((project) => project.type === 'personal');
const professionalProjects = projects.filter((project) => project.type === 'professional');
---

<section id="proyectos" aria-labelledby="projects-heading" class="border-b border-border-dark py-20 sm:py-24 lg:py-28">
  <div class="mb-12 max-w-2xl sm:mb-16">
    <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">Trabajo seleccionado</p>
    <h2 id="projects-heading" class="text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
      Proyectos
    </h2>
    <p class="mt-4 text-base leading-7 text-muted">
      Productos personales y soluciones desarrolladas para entornos financieros de alta exigencia.
    </p>
  </div>

  <div>
    <div class="mb-14">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.12em] text-muted">Proyectos personales</h3>
      <div class="grid border-t border-border-dark md:grid-cols-2">
        {
          personalProjects.map((project) => (
            <article class="border-b border-border-dark py-8 md:px-7 md:odd:border-r md:odd:pl-0">
              <h4 class="text-xl font-semibold tracking-[-0.025em] text-ink">{project.title}</h4>
              <p class="mt-4 max-w-xl text-[0.95rem] leading-7 text-muted">{project.description}</p>

              <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2" aria-label={'Tecnologías de ' + project.title}>
                {
                  project.tech.map((technology) => (
                    <li class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-subtle">{technology}</li>
                  ))
                }
              </ul>

              {
                project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-muted transition-colors hover:text-accent"
                    aria-label="Abrir el perfil de GitHub en una pestaña nueva"
                  >
                    <Icon name="github" size={16} />
                    Perfil de GitHub <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </article>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.12em] text-muted">
        Soluciones profesionales · Caja Tacna
      </h3>
      <div class="grid border-t border-border-dark md:grid-cols-2">
        {
          professionalProjects.map((project) => (
            <article class="border-b border-border-dark py-8 md:px-7 md:odd:border-r md:odd:pl-0">
              <h4 class="text-xl font-semibold tracking-[-0.025em] text-ink">{project.title}</h4>
              <p class="mt-4 max-w-xl text-[0.95rem] leading-7 text-muted">{project.description}</p>

              <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2" aria-label={'Tecnologías de ' + project.title}>
                {
                  project.tech.map((technology) => (
                    <li class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-subtle">{technology}</li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
