---
import { cases, projects } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="proyectos" aria-labelledby="projects-heading" class="py-12 sm:py-16">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 id="projects-heading" class="text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">Casos de estudio</h2>
    <p class="max-w-md text-sm leading-6 text-muted">
      Sistemas en producción del sector financiero. Cuento el problema, la decisión y el resultado; los datos internos se quedan en casa.
    </p>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {
      cases.map((item, index) => (
        <article class={'fade-up flex min-w-0 flex-col rounded-xl border border-white/10 bg-panel p-6 sm:p-8' + (index === 0 ? ' lg:col-span-2' : '')}>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">{item.tag}</p>
          <h3 class="mt-3 text-xl font-semibold leading-snug tracking-[-0.02em] text-ink sm:text-2xl">{item.title}</h3>
          <dl class={'mt-6 grid gap-5' + (index === 0 ? ' md:grid-cols-3' : '')}>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-subtle">Reto</dt>
              <dd class="mt-2 text-[0.95rem] leading-7 text-muted">{item.problem}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-subtle">Qué hice</dt>
              <dd class="mt-2 text-[0.95rem] leading-7 text-muted">{item.solution}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-subtle">Resultado</dt>
              <dd class="mt-2 text-[0.95rem] font-semibold leading-7 text-ink">{item.result}</dd>
            </div>
          </dl>
          <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label={'Tecnologías de ' + item.title}>
            {item.tech.map((technology) => <li class="rounded-full border border-white/10 px-3 py-1 text-xs font-medium text-muted">{technology}</li>)}
          </ul>
        </article>
      ))
    }
  </div>

  <h3 class="mt-16 text-2xl font-semibold tracking-[-0.02em] text-ink">Proyectos propios</h3>
  <p class="mt-2 text-sm text-muted">Código abierto, para ver de principio a fin.</p>
  <div class="mt-6 grid gap-5 md:grid-cols-2">
    {
      projects.map((project) => (
        <article class="fade-up flex min-w-0 flex-col rounded-xl border border-white/10 p-6">
          <h4 class="text-lg font-semibold text-ink">{project.title}</h4>
          <p class="mt-3 text-[0.95rem] leading-7 text-muted">{project.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label={'Tecnologías de ' + project.title}>
            {project.tech.map((technology) => <li class="rounded-full border border-white/10 px-3 py-1 text-xs font-medium text-muted">{technology}</li>)}
          </ul>
          <a href={project.github} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex min-h-11 items-center gap-2 pt-4 text-sm font-semibold text-accent-soft transition-colors hover:text-ink" aria-label={'Ver ' + project.title + ' en GitHub (pestaña nueva)'}>
            <Icon name="github" size={16} /> Ver en GitHub <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
