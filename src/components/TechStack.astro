---
import { techStack } from '../data/portfolio';
---

<section id="stack" aria-labelledby="stack-heading" class="py-16 sm:py-24">
  <div class="overflow-hidden rounded-xl border border-white/10 bg-panel">
    <div class="grid gap-8 border-b border-white/10 px-5 py-9 sm:px-8 lg:grid-cols-12 lg:items-end lg:px-10 lg:py-12">
      <div class="lg:col-span-7">
        <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-accent-soft">03 / Capacidades</p>
        <h2 id="stack-heading" class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.045em] text-ink sm:text-5xl">
          Amplitud técnica con profundidad práctica.
        </h2>
      </div>
      <p class="max-w-md text-sm leading-7 text-muted lg:col-span-5 lg:justify-self-end">
        Conecto arquitectura, interfaces, datos, calidad y operación para entregar sistemas completos, no piezas aisladas.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3">
      {
        techStack.map((category, index) => (
          <article class="border-b border-white/10 p-5 sm:border-r sm:p-7 lg:p-8 [&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0">
            <span class="font-mono text-[0.62rem] font-semibold text-accent-soft">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-lg font-semibold tracking-[-0.02em] text-ink">{category.category}</h3>
            <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-2">
              {category.items.map((technology) => <li class="text-xs leading-5 text-muted">{technology}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
