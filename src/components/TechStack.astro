---
import { techStack } from '../data/portfolio';
---

<section id="stack" aria-labelledby="stack-heading" class="border-b border-border-dark py-20 sm:py-24 lg:py-28">
  <div class="mb-12 max-w-2xl sm:mb-16">
    <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">Especialidad</p>
    <h2 id="stack-heading" class="text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
      Áreas de experiencia
    </h2>
    <p class="mt-4 text-base leading-7 text-muted">
      Capacidades para diseñar, construir y operar soluciones de extremo a extremo.
    </p>
  </div>

  <div class="border-t border-border-dark">
    {
      techStack.map((category) => (
        <article class="grid gap-5 border-b border-border-dark py-8 md:grid-cols-12 md:gap-10">
          <h3 class="text-base font-semibold text-ink md:col-span-4">{category.category}</h3>
          <ul class="flex flex-wrap gap-x-5 gap-y-3 md:col-span-8">
            {
              category.items.map((technology) => (
                <li class="text-sm leading-6 text-muted">{technology}</li>
              ))
            }
          </ul>
        </article>
      ))
    }
  </div>
</section>
