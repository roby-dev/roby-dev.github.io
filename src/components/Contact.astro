---
import { developer, socials } from '../data/portfolio';
import Icon from './Icon.astro';

const professionalSocials = socials.filter((social) => social.icon !== 'email');
---

<section id="contacto" aria-labelledby="contact-heading" class="full-bleed theme-contact py-20 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
    <div class="min-w-0 lg:col-span-9">
      <p class="font-mono text-xs font-black uppercase tracking-[0.18em]">04 / Contacto</p>
      <h2 id="contact-heading" class="mt-5 max-w-5xl text-[clamp(2.55rem,9vw,7.5rem)] font-black uppercase leading-[0.82] tracking-[-0.07em]">
        ¿Construimos<br />algo que<br /><span class="text-bg-dark">importe?</span>
      </h2>
    </div>
    <div class="min-w-0 lg:col-span-3">
      <p class="border-l-4 border-ink pl-5 text-base font-bold leading-7">
        Ubicado en {developer.location}. Disponible para conversar sobre arquitectura, producto y sistemas exigentes.
      </p>
    </div>
  </div>

  <a href={'mailto:' + developer.email} class="mt-14 flex min-h-20 items-center justify-between gap-6 border-y-2 border-ink py-5 text-lg font-black transition-colors hover:bg-ink hover:px-5 hover:text-bg-dark sm:text-3xl">
    <span class="break-all">{developer.email}</span>
    <span class="shrink-0 text-3xl" aria-hidden="true">↗</span>
  </a>

  <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
    {
      professionalSocials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-black hover:underline">
          <Icon name={social.icon as 'github' | 'linkedin'} size={18} /> {social.label} <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
</section>
