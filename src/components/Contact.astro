---
import { developer, socials } from '../data/portfolio';
import Icon from './Icon.astro';

const professionalSocials = socials.filter((social) => social.icon !== 'email');
---

<section id="contacto" aria-labelledby="contact-heading" class="py-16 sm:py-24">
  <div class="fade-up overflow-hidden rounded-xl border border-accent/25 bg-surface">
    <div class="grid gap-9 px-5 py-10 sm:px-8 sm:py-14 lg:grid-cols-12 lg:items-end lg:px-12 lg:py-16">
      <div class="min-w-0 lg:col-span-8">
        <h2 id="contact-heading" class="mt-4 max-w-3xl text-[clamp(2.2rem,6vw,5rem)] font-semibold leading-[1.02] tracking-[-0.05em] text-ink">
          Conversemos.
        </h2>
      </div>
      <div class="min-w-0 lg:col-span-4">
        <p class="max-w-md text-sm leading-7 text-muted">
          Si quieres hablar de arquitectura, pagos o .NET, escríbeme. Estoy en {developer.location} (UTC−5).
        </p>
        <a href={'mailto:' + developer.email} class="mt-6 inline-flex min-h-12 max-w-full items-center gap-3 rounded-md bg-accent px-5 text-sm font-bold text-bg-dark transition-colors hover:bg-accent-soft">
          Escribirme <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-5 border-t border-white/10 px-5 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
      <a href={'mailto:' + developer.email} class="min-w-0 break-all text-sm font-medium text-muted transition-colors hover:text-accent-soft sm:break-normal">
        {developer.email}
      </a>
      <div class="flex gap-5">
        {
          professionalSocials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-accent-soft">
              <Icon name={social.icon as 'github' | 'linkedin'} size={16} /> {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
