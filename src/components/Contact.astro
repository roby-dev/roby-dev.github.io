---
import { developer, socials } from '../data/portfolio';
import Icon from './Icon.astro';

const professionalSocials = socials.filter((social) => social.icon !== 'email');
---

<section id="contacto" aria-labelledby="contact-heading" class="py-20 sm:py-24 lg:py-28">
  <div class="max-w-4xl">
    <p class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">Contacto</p>
    <h2 id="contact-heading" class="max-w-3xl text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-ink sm:text-5xl lg:text-6xl">
      Conversemos sobre sistemas que necesiten operar con solidez.
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
      Ubicado en {developer.location}. Para consultas profesionales, puedes escribirme directamente por correo.
    </p>

    <a
      href={'mailto:' + developer.email}
      class="mt-10 inline-flex min-h-12 max-w-full items-center border-b border-accent pb-2 text-lg font-semibold text-ink transition-colors hover:text-accent sm:text-2xl"
    >
      <Icon name="email" size={20} class="mr-3 shrink-0" />
      <span class="break-all">{developer.email}</span>
    </a>

    <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
      {
        professionalSocials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-muted transition-colors hover:text-accent"
          >
            <Icon name={social.icon as 'github' | 'linkedin'} size={17} />
            {social.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
