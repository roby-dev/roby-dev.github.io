---
import { developer, heroHighlights } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="inicio" aria-labelledby="hero-heading" class="border-b border-border-dark pb-20 pt-20 sm:pb-24 sm:pt-28 lg:pb-28 lg:pt-32">
  <div class="max-w-5xl">
    <p class="fade-up d1 mb-7 font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">
      Arquitecto de software · Sistemas financieros
    </p>

    <h1
      id="hero-heading"
      class="fade-up d2 max-w-5xl text-[clamp(2.5rem,7vw,6.5rem)] font-semibold leading-[0.94] tracking-[-0.055em] text-ink"
    >
      {developer.name}
    </h1>

    <p class="fade-up d3 mt-8 max-w-2xl text-lg leading-8 text-muted sm:text-xl sm:leading-9">
      Diseño y construyo sistemas financieros seguros, escalables y preparados para operar con confiabilidad.
    </p>

    <div class="fade-up d4 mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href="#experiencia"
        class="inline-flex min-h-12 items-center justify-center bg-accent px-6 text-sm font-bold text-bg-dark transition-colors hover:bg-[#efbd5e]"
      >
        Ver experiencia
      </a>
      <a
        href="/cv.pdf"
        download
        class="inline-flex min-h-12 items-center justify-center border border-border-dark px-6 text-sm font-semibold text-ink transition-colors hover:border-muted hover:bg-white/[0.03]"
      >
        Descargar CV
      </a>
      <a
        href={'mailto:' + developer.email}
        class="inline-flex min-h-12 items-center justify-center px-4 text-sm font-semibold text-muted transition-colors hover:text-ink"
      >
        Contactar
      </a>
    </div>
  </div>

  <dl class="mt-16 grid border-y border-border-dark sm:grid-cols-3">
    {
      heroHighlights.map((highlight) => (
        <div class="border-b border-border-dark py-6 last:border-b-0 sm:border-b-0 sm:border-r sm:px-6 sm:first:pl-0 sm:last:border-r-0">
          <dt class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-subtle">{highlight.label}</dt>
          <dd class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-ink">{highlight.value}</dd>
          <dd class="mt-2 text-sm leading-6 text-muted">{highlight.detail}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <a
      href={developer.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-muted transition-colors hover:text-accent"
    >
      <Icon name="github" size={16} />
      GitHub <span aria-hidden="true">↗</span>
    </a>
    <a
      href={developer.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-muted transition-colors hover:text-accent"
    >
      <Icon name="linkedin" size={16} />
      LinkedIn <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
