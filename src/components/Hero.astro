---
import { developer } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="inicio" aria-labelledby="hero-heading" class="py-12 sm:py-16 lg:py-20">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
    <div class="min-w-0">
      <p class="fade-up d1 font-heading text-xl font-semibold text-muted sm:text-2xl">Hola, soy</p>
      <h1 id="hero-heading" class="fade-up d2 mt-2 text-[clamp(2.8rem,8vw,5.25rem)] font-bold leading-[1.02] tracking-[-0.04em] text-ink">
        Roby Zúñiga
      </h1>
      <p class="fade-up d2 mt-3 font-heading text-[clamp(1.35rem,3.4vw,1.9rem)] font-semibold text-accent">
        Arquitecto de Software · Fintech y pagos
      </p>
      <p class="fade-up d3 mt-6 max-w-xl text-lg leading-8 text-muted">
        Diseño integraciones de pago y backends .NET para sistemas financieros que no pueden fallar. Disponible para equipos y clientes de cualquier parte del mundo, en remoto.
      </p>

      <div class="fade-up d4 mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={'mailto:' + developer.email} class="inline-flex min-h-12 items-center justify-center rounded-md bg-accent px-7 text-sm font-bold text-bg-dark transition-colors hover:bg-accent-soft">
          Cuéntame tu proyecto
        </a>
        <a href="/cv.pdf" download class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/15 px-7 text-sm font-semibold text-ink transition-colors hover:border-white/35 hover:bg-surface">
          Mi CV
        </a>
        <div class="flex items-center gap-1 sm:ml-2">
          <a href={developer.github} target="_blank" rel="noopener noreferrer" class="inline-flex size-12 items-center justify-center text-muted transition-colors hover:text-accent-soft" aria-label="Abrir GitHub en una pestaña nueva">
            <Icon name="github" size={19} />
          </a>
          <a href={developer.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex size-12 items-center justify-center text-muted transition-colors hover:text-accent-soft" aria-label="Abrir LinkedIn en una pestaña nueva">
            <Icon name="linkedin" size={19} />
          </a>
        </div>
      </div>
    </div>

    <div class="fade-up d3 mx-auto w-full max-w-[17rem] sm:max-w-[22rem] lg:max-w-none">
      <div class="aspect-square w-full rounded-full border-[10px] border-accent p-3">
        <img
          src="/roby.jpg"
          alt="Retrato de Roby Zúñiga"
          width="397"
          height="531"
          fetchpriority="high"
          class="size-full rounded-full object-cover object-[50%_22%]"
        />
      </div>
    </div>
  </div>
</section>
