---
import { developer } from '../data/portfolio';
import Icon from './Icon.astro';

const nameParts = developer.name.split(' ');
const firstLine = nameParts.slice(0, 2).join(' ');
const secondLine = nameParts.slice(2).join(' ');
---

<section id="inicio" aria-labelledby="hero-heading" class="relative py-14 sm:py-20 lg:min-h-[calc(100svh-4.75rem)] lg:py-24">
  <div class="mb-12 flex flex-wrap items-center justify-between gap-4 border-y border-ink py-3 font-mono text-[0.66rem] font-bold uppercase tracking-[0.12em]">
    <span class="inline-flex items-center gap-2"><span class="size-2 animate-pulse rounded-full bg-signal"></span> Disponible para nuevos retos</span>
    <span>{developer.location} · UTC−5</span>
    <span class="hidden sm:inline">Portafolio / 2026</span>
  </div>

  <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-8">
      <p class="fade-up d1 mb-5 font-mono text-xs font-black uppercase tracking-[0.18em] text-signal">
        Arquitectura · Producto · Operaciones
      </p>

      <h1 id="hero-heading" class="fade-up d2 text-[clamp(3.4rem,9.5vw,8.4rem)] font-black uppercase leading-[0.79] tracking-[-0.075em] text-ink">
        <span class="block">{firstLine}</span>
        <span class="mt-3 block text-signal sm:mt-5">{secondLine}</span>
      </h1>

      <div class="fade-up d3 mt-9 grid gap-7 border-l-4 border-accent pl-5 sm:grid-cols-[1fr_auto] sm:items-end sm:pl-7">
        <p class="max-w-2xl text-lg font-medium leading-8 text-muted sm:text-xl sm:leading-9">
          Diseño, construyo y opero software de extremo a extremo: desde la arquitectura en .NET hasta las interfaces, los datos y la entrega continua.
        </p>
        <p class="font-mono text-xs font-bold uppercase leading-5 tracking-[0.12em] text-ink">
          ~4 años<br />full stack
        </p>
      </div>

      <div class="fade-up d4 mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#proyectos" class="inline-flex min-h-13 items-center justify-between gap-7 bg-ink px-6 text-sm font-black text-bg-dark transition-transform hover:-translate-y-1">
          Explorar trabajo <span aria-hidden="true">↓</span>
        </a>
        <a href="/cv.pdf" download class="inline-flex min-h-13 items-center justify-center border-2 border-ink px-6 text-sm font-black text-ink transition-colors hover:bg-accent">
          Descargar CV
        </a>
        <a href={'mailto:' + developer.email} class="inline-flex min-h-13 items-center justify-center px-4 text-sm font-black text-signal hover:underline">
          Hablemos →
        </a>
      </div>
    </div>

    <aside class="fade-up d4 border-2 border-ink bg-card-bg p-4 shadow-[10px_10px_0_#ff5c35] sm:p-6 lg:col-span-4" aria-label="Mapa de capacidades">
      <div class="flex items-center justify-between border-b border-ink pb-4 font-mono text-[0.65rem] font-black uppercase tracking-[0.12em]">
        <span>System map</span>
        <span class="text-signal">Live / 01</span>
      </div>
      <div class="architecture-map relative mt-4 aspect-square border border-ink" aria-hidden="true">
        <span class="map-node map-node-top">Interfaces</span>
        <span class="map-node map-node-right">Data</span>
        <span class="map-node map-node-bottom">Delivery</span>
        <span class="map-node map-node-left">Integration</span>
        <span class="map-node map-node-core">.NET<br />Core</span>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-4 border-t border-ink pt-4 text-xs">
        <div><span class="block font-mono text-[0.6rem] uppercase text-subtle">Enfoque</span><strong class="mt-1 block">Sistemas críticos</strong></div>
        <div><span class="block font-mono text-[0.6rem] uppercase text-subtle">Entrega</span><strong class="mt-1 block">End-to-end</strong></div>
      </div>
    </aside>
  </div>

  <div class="mt-14 flex flex-wrap gap-x-6 gap-y-2 border-t border-ink pt-5 text-sm font-bold">
    <a href={developer.github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 hover:text-signal">
      <Icon name="github" size={17} /> GitHub <span aria-hidden="true">↗</span>
    </a>
    <a href={developer.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 hover:text-signal">
      <Icon name="linkedin" size={17} /> LinkedIn <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
